# Spam Detector — Configuration
# Copy to .env and fill in values before running docker-compose.

# API Server
SPAM_API_HOST=0.0.0.0
SPAM_API_PORT=8000
SPAM_LOG_LEVEL=info

# Model
SPAM_BOOTSTRAP_MODEL_IF_MISSING=true
SPAM_TRAIN_ON_START=false
SPAM_RETRAIN_TIMEOUT_SECONDS=900
SPAM_SPAM_THRESHOLD=0.55

# Feedback Store (file or mysql)
SPAM_FEEDBACK_BACKEND=file

# MySQL (required only when SPAM_FEEDBACK_BACKEND=mysql)
SPAM_DB_HOST=
SPAM_DB_PORT=3306
SPAM_DB_USER=
SPAM_DB_PASSWORD=
SPAM_DB_NAME=spam_detector
SPAM_DB_TABLE=feedback_entries

# MySQL Container
MYSQL_DATABASE=spam_detector
MYSQL_ROOT_PASSWORD=change-me-in-production
MYSQL_PORT_FORWARD=3306

# JWT (used by future auth middleware)
# SPAM_JWT_SECRET_KEY=
